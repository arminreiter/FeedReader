<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 tests the library's net8.0 build; net48 (Windows only) tests the net462 build. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net8.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Feeds\**;Html\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- ponytail: Linux/macOS OpenSSL rejects the SHA1 strong-name signature of key.snk, so the
         library is built unsigned for local test runs there. The library csproj (and the
         published, signed NuGet build) stays untouched. -->
    <ProjectReference Include="..\FeedReader\FeedReader.csproj"
                      AdditionalProperties="SignAssembly=false"
                      Condition="'$(OS)' != 'Windows_NT'" />
    <ProjectReference Include="..\FeedReader\FeedReader.csproj"
                      Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

</Project>
