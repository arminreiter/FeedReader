    <item>
      <guid isPermaLink="true">https://mastodon.social/@Mastodon/117043346514398510</guid>
      <link>https://mastodon.social/@Mastodon/117043346514398510</link>
      <pubDate>Wed, 05 Aug 2026 14:22:15 +0000</pubDate>
      <description>&lt;p&gt;We&amp;#39;re excited to share the results from Mastodon&amp;#39;s first &lt;a href="https://mastodon.social/tags/DiscoveryWeek" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;DiscoveryWeek&lt;/span&gt;&lt;/a&gt;!&lt;/p&gt;&lt;p&gt;In case you missed it, earlier this year our Head of Design &lt;span class="h-card" translate="no"&gt;&lt;a href="https://mastodon.social/@imanijoy" class="u-url mention"&gt;@&lt;span&gt;imanijoy&lt;/span&gt;&lt;/a&gt;&lt;/span&gt; arranged a week of workshops and surveys to get to know you, learn about your needs and wants, and discover how you&amp;#39;re using (and want to use) Mastodon.&lt;/p&gt;&lt;p&gt;This week was tremendously helpful for us, and we&amp;#39;re grateful to everyone who participated.&lt;/p&gt;&lt;p&gt;Here&amp;#39;s what we learned: &lt;br /&gt;&lt;a href="https://blog.joinmastodon.org/2026/08/discovery-week-2026-what-we-learned-and-what-were-doing-next/" target="_blank" rel="nofollow noopener" translate="no"&gt;&lt;span class="invisible"&gt;https://&lt;/span&gt;&lt;span class="ellipsis"&gt;blog.joinmastodon.org/2026/08/&lt;/span&gt;&lt;span class="invisible"&gt;discovery-week-2026-what-we-learned-and-what-were-doing-next/&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://mastodon.social/tags/Mastodon" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;Mastodon&lt;/span&gt;&lt;/a&gt; &lt;a href="https://mastodon.social/tags/Fediverse" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;Fediverse&lt;/span&gt;&lt;/a&gt; &lt;a href="https://mastodon.social/tags/SocialWeb" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;SocialWeb&lt;/span&gt;&lt;/a&gt; &lt;a href="https://mastodon.social/tags/OpenSocial" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;OpenSocial&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;</description>
      <category>discoveryweek</category>
      <category>mastodon</category>
      <category>fediverse</category>
      <category>socialweb</category>
      <category>opensocial</category>
    </item>
