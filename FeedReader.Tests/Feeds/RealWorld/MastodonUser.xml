    <item>
      <guid isPermaLink="true">https://mastodon.social/@Mastodon/117466985005297414</guid>
      <link>https://mastodon.social/@Mastodon/117466985005297414</link>
      <pubDate>Mon, 19 Oct 2026 09:59:05 +0000</pubDate>
      <description>&lt;p&gt;We didn’t want to require you to have a GitHub profile to report issues or suggest ideas, so starting now you can do it on our new community forum. &lt;/p&gt;&lt;p&gt;You can also vote for other people’s ideas to keep things manageable. It’s the main place we’ll be looking for feedback!&lt;/p&gt;&lt;p&gt;&lt;a href="https://community.joinmastodon.org/" target="_blank" rel="nofollow noopener" translate="no"&gt;&lt;span class="invisible"&gt;https://&lt;/span&gt;&lt;span class=""&gt;community.joinmastodon.org/&lt;/span&gt;&lt;span class="invisible"&gt;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;</description>
    </item>
    <item>
      <guid isPermaLink="true">https://mastodon.social/@Mastodon/117466983307949301</guid>
      <link>https://mastodon.social/@Mastodon/117466983307949301</link>
      <pubDate>Mon, 19 Oct 2026 09:58:40 +0000</pubDate>
      <description>&lt;p&gt;&lt;a href="https://mastodon.social/tags/Mastodon" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;Mastodon&lt;/span&gt;&lt;/a&gt; is getting a new look in our upcoming 5.0 release.&lt;/p&gt;&lt;p&gt;We wrote a bit more about our design process and how we approach community input. If you’re on mastodon.social you will see the new design tomorrow, on Tuesday. We rely on your feedback!&lt;/p&gt;&lt;p&gt;&lt;a href="https://blog.joinmastodon.org/2026/10/5.0-a-closer-look/" target="_blank" rel="nofollow noopener" translate="no"&gt;&lt;span class="invisible"&gt;https://&lt;/span&gt;&lt;span class="ellipsis"&gt;blog.joinmastodon.org/2026/10/&lt;/span&gt;&lt;span class="invisible"&gt;5.0-a-closer-look/&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;</description>
      <category>mastodon</category>
    </item>
    <item>
      <guid isPermaLink="true">https://mastodon.social/@Mastodon/117411420916699261</guid>
      <link>https://mastodon.social/@Mastodon/117411420916699261</link>
      <pubDate>Fri, 09 Oct 2026 14:28:25 +0000</pubDate>
      <description>&lt;p&gt;New &lt;a href="https://mastodon.social/tags/Plushtodon" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;Plushtodon&lt;/span&gt;&lt;/a&gt; colours now available for pre-orders on our shop! This is a way to support our work and get a squishy friend at the same time.&lt;/p&gt;&lt;p&gt;&lt;a href="https://blog.joinmastodon.org/2026/10/plushtodon-pre-orders-now-open/" target="_blank" rel="nofollow noopener" translate="no"&gt;&lt;span class="invisible"&gt;https://&lt;/span&gt;&lt;span class="ellipsis"&gt;blog.joinmastodon.org/2026/10/&lt;/span&gt;&lt;span class="invisible"&gt;plushtodon-pre-orders-now-open/&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://mastodon.social/tags/Merchtodon" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;Merchtodon&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;</description>
      <category>Plushtodon</category>
      <category>Merchtodon</category>
    </item>
    <item>
      <guid isPermaLink="true">https://mastodon.social/@Mastodon/117156549508722805</guid>
      <link>https://mastodon.social/@Mastodon/117156549508722805</link>
      <pubDate>Tue, 25 Aug 2026 14:11:16 +0000</pubDate>
      <description>&lt;p&gt;Hannah Aubry is leaving Mastodon after her time with us as community director and board member. We’re very grateful for her contributions, ideas, and commitment to Mastodon and the fediverse. Thank you, Hannah! We wish you all the very best for what comes next.&lt;/p&gt;</description>
    </item>
    <item>
      <guid isPermaLink="true">https://mastodon.social/@Mastodon/117117221397911074</guid>
      <link>https://mastodon.social/@Mastodon/117117221397911074</link>
      <pubDate>Tue, 18 Aug 2026 15:29:36 +0000</pubDate>
      <description>&lt;p&gt;After publishing the results of Discovery Week, we can now give you a first sneak peak at Mastodon 5.0, our next big version. It will bring a new visual look to your screens, a refreshed and calmer layout, as well as a new composer.&lt;/p&gt;&lt;p&gt;&lt;a href="https://blog.joinmastodon.org/2026/08/5.0-laying-the-foundation/" target="_blank" rel="nofollow noopener" translate="no"&gt;&lt;span class="invisible"&gt;https://&lt;/span&gt;&lt;span class="ellipsis"&gt;blog.joinmastodon.org/2026/08/&lt;/span&gt;&lt;span class="invisible"&gt;5.0-laying-the-foundation/&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://mastodon.social/tags/mastodon" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;mastodon&lt;/span&gt;&lt;/a&gt; &lt;a href="https://mastodon.social/tags/mastodon5" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;mastodon5&lt;/span&gt;&lt;/a&gt;.0&lt;/p&gt;</description>
      <category>mastodon</category>
      <category>Mastodon5</category>
    </item>
    <item>
      <guid isPermaLink="true">https://mastodon.social/@Mastodon/117093587981367953</guid>
      <link>https://mastodon.social/@Mastodon/117093587981367953</link>
      <pubDate>Fri, 14 Aug 2026 11:19:19 +0000</pubDate>
      <description>&lt;p&gt;Here is a &lt;a href="https://mastodon.social/tags/FeaturedServer" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;FeaturedServer&lt;/span&gt;&lt;/a&gt; for 🌎 Earth, 🦎 Earthlings, and their ⚖️ Advocates...&lt;/p&gt;&lt;p&gt;&lt;a href="https://earth.law/about" target="_blank" rel="nofollow noopener" translate="no"&gt;&lt;span class="invisible"&gt;https://&lt;/span&gt;&lt;span class=""&gt;earth.law/about&lt;/span&gt;&lt;span class="invisible"&gt;&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Earth.Law is for:&lt;br /&gt;📜 Environmental lawyers &amp;amp; policy-makers&lt;br /&gt;🦋 Conservationists &amp;amp; ecologists&lt;br /&gt;🔬 Scientists in related fields&lt;br /&gt;📚 Educators and students of environmental studies&lt;br /&gt;🎤 Activists &amp;amp; advocates&lt;/p&gt;&lt;p&gt;♻️ Hosted on a dedicated server in 🇫🇮 Helsinki and recognised by the Green Web Foundation for using renewable energy.&lt;/p&gt;&lt;p&gt; &lt;a href="https://mastodon.social/tags/CommunitySpotlight" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;CommunitySpotlight&lt;/span&gt;&lt;/a&gt; &lt;a href="https://mastodon.social/tags/Fediverse" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;Fediverse&lt;/span&gt;&lt;/a&gt; &lt;a href="https://mastodon.social/tags/Mastodon" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;Mastodon&lt;/span&gt;&lt;/a&gt; &lt;a href="https://mastodon.social/tags/SocialWeb" class="mention hashtag" rel="tag"&gt;#&lt;span&gt;SocialWeb&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;</description>
      <category>featuredserver</category>
      <category>communityspotlight</category>
      <category>fediverse</category>
      <category>mastodon</category>
      <category>socialweb</category>
    </item>
