<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>key.snk</AssemblyOriginatorKeyFile>
	  <Title>CodeHollow.FeedReader</Title>
    <Authors>Armin Reiter</Authors>
    <Company>Reiter ITS</Company>
    <Product>CodeHollow.FeedReader</Product>
    <Description>RSS, ATOM and JSON Feed reader/parser. FeedReader is a .NET Standard 2.0 library used for reading and parsing RSS, ATOM and JSON feeds. Supports RSS 0.91, 0.92, 1.0, 2.0, ATOM, JSON Feed 1.0/1.1 and the iTunes and Podcasting 2.0 podcast extensions. Library tested with multiple languages and feeds.</Description>
	  <Copyright>Copyright 2026</Copyright>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageProjectUrl>https://github.com/arminreiter/FeedReader/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/arminreiter/FeedReader/</RepositoryUrl>
    <Version>2.0.0</Version>
    <PackageReleaseNotes>New:
- JSON Feed 1.0/1.1 support (FeedType.JsonFeed), incl. html discovery of application/feed+json
- Podcasting 2.0 tags via feed.GetPodcastChannel() / item.GetPodcastItem()
- Helpers.HttpClient to use a custom HttpClient (proxy, logging, timeout)
- Atom 0.3 fallbacks (tagline, issued/created, modified), RSS 1.0 content:encoded

Fixes:
- RFC 2822 time zones (EST, PST, ...) are converted correctly - dates of such feeds change, they were read as utc
- Code pages like windows-1251 decode on .NET Core / .NET 8 (#49)
- Atom categories use label, then term, then text (#56)
- HTML feed link parsing: unquoted attributes, data-rel, regex timeout</PackageReleaseNotes>
    <PackageTags>feed rss atom jsonfeed podcast</PackageTags>
    <AssemblyName>CodeHollow.FeedReader</AssemblyName>
    <RootNamespace>CodeHollow.FeedReader</RootNamespace>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageIconUrl>https://raw.github.com/codehollow/FeedReader/master/FeedReader/icon.png</PackageIconUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Fedora/RHEL block SHA1, which strong-name signing needs. Allow it for the compiler process only
       (see build/openssl-sha1.cnf). Shared compilation is off because the compiler server ignores CscEnvironment. -->
  <PropertyGroup Condition="Exists('/etc/crypto-policies/config')">
    <CscEnvironment>OPENSSL_CONF=$(MSBuildThisFileDirectory)../build/openssl-sha1.cnf</CscEnvironment>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- code pages like windows-1251 (issue #49); built into net8.0, native on .NET Framework -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <None Include="icon.png" Pack="True" PackagePath="\" />
  </ItemGroup>

</Project>